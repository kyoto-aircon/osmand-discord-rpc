<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Shares your live OsmAnd trip recording with Discord as rich presence."
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="monospace"
            android:text="OFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="40dp"
            android:text="Not sharing."
            android:textColor="#666666"
            android:textSize="14sp" />

        <Button
            android:id="@+id/grant_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Grant OsmAnd access" />

        <Button
            android:id="@+id/toggle_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Start sharing" />

        <Button
            android:id="@+id/open_osmand_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open OsmAnd" />

        <Button
            android:id="@+id/logs_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="View logs" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:lineSpacingExtra="4dp"
            android:text="Setup&#10;1. In OsmAnd, enable the Trip recording plugin and start a recording.&#10;2. Tap “Grant OsmAnd access” and turn on “Trip recording” and “Tracks: view” (only needed on OsmAnd 5.5+).&#10;3. Tap “Start sharing”, allow location, then enable the Kettu plugin.&#10;&#10;The status shown here is served on 127.0.0.1:8090/status for the Discord mod. On OsmAnd 5.5+ the values come from OsmAnd’s recording; on older builds the app uses this phone’s GPS.&#10;&#10;Note: on OsmAnd 5.5+ keep the trip recording running (stopping it clears your Discord presence); on older builds sharing runs until you tap Stop. Battery optimisations may stop the share in the background — disable them for this app if that happens."
            android:textColor="#444444"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
